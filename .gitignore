tests/_settings/
_test_settings/
.pytest_cache/
.coverage
htmlcov/
*.log
_build.log

# 临时诊断脚本产物
*.tmp

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- 运行期数据（含用户隐私）
# 插件目录缓存、下载缓存、崩溃报告
addons_cache/
thumbnails/
budeco_catalog.json
*_catalog.json
crashes/

# ---------------------------------------------------------------- 凭据（防误提交）
